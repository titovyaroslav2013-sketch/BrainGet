
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BrainGet</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0; padding: 20px 14px 100px;
  font-family: Arial, sans-serif; color: white;
  background: linear-gradient(140deg,#07152e,#123d77,#090d19);
  min-height: 100vh;
}
main { max-width: 480px; margin: auto; }
header,.card {
  background: #101d38; border: 1px solid #315b91;
  border-radius: 18px; padding: 18px; margin-bottom: 14px;
}
header { text-align: center; border: 2px solid #16cfff;
  box-shadow: 0 0 24px #168bff44; }
h1 { font-size: 38px; margin: 0; }
h1 span { color: #21d5ff; }
p { color: #c0d5f5; line-height: 1.5; }
h2 { font-size: 23px; }
h3 { margin-top: 0; }
button,select {
  width: 100%; padding: 13px; border: 0;
  border-radius: 11px; font-size: 15px;
}
button {
  background: #19caff; color: #07152e;
  font-weight: bold; cursor: pointer; margin-top: 7px;
}
button:active { transform: scale(.98); }
button.secondary { background: #243e66; color: white; }
button:disabled { opacity: .45; }
nav {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; justify-content: center; gap: 5px;
  background: #081326f5; padding: 10px 5px;
  border-top: 1px solid #315b91; z-index: 10;
}
nav button {
  max-width: 100px; padding: 10px 3px;
  margin: 0; font-size: 11px;
  background: #172b49; color: white;
}
nav button.active { background: #19caff; color: #07152e; }
.item { border: 1px solid #315b91; border-radius: 12px;
  padding: 12px; margin: 8px 0; background: #0b1930; }
.small { font-size: 12px; color: #8fb5e9; }
#message { text-align: center; font-weight: bold; }
</style>
</head>
<body>
<main>
  <header>
    <h1><span>Brain</span>Get</h1>
    <p>🧠 Твоя вселенная Brainrot!</p>
    <strong>⭐ Монеты: <span id="coins">500</span></strong>
  </header>
  <div id="app"></div>
  <p id="message"></p>
</main>

<nav>
  <button onclick="go('home')" id="nav-home">🏠 Главная</button>
  <button onclick="go('cases')" id="nav-cases">🎁 Кейсы</button>
  <button onclick="go('upgrade')" id="nav-upgrade">⚡ Апгрейд</button>
  <button onclick="go('inventory')" id="nav-inventory">🎒 Инвентарь</button>
</nav>

<script>
const initial = {
  coins: 500,
  inventory: []
};

let data;
try {
  data = JSON.parse(localStorage.getItem('brainget-save')) || initial;
} catch(e) {
  data = initial;
}
let page = 'home';

const rewards = [
  {name:'Noobini Pizzanini', rarity:'Обычный', value:50, emoji:'🍕'},
  {name:'Tralalero Tralala', rarity:'Редкий', value:120, emoji:'🦈'},
  {name:'Tung Tung Tung Sahur', rarity:'Эпический', value:250, emoji:'🥁'},
  {name:'Brr Brr Patapim', rarity:'Легендарный', value:500, emoji:'🌳'},
  {name:'Brainrot God', rarity:'Мифический', value:1000, emoji:'👑'}
];

function save() {
  localStorage.setItem('brainget-save', JSON.stringify(data));
  document.getElementById('coins').textContent = data.coins;
}

function go(name) {
  page = name;
  document.getElementById('message').textContent = '';
  render();
}

function say(text) {
  document.getElementById('message').textContent = text;
}

function render() {
  save();
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  const nav = document.getElementById('nav-' + page);
  if(nav) nav.classList.add('active');

  const app = document.getElementById('app');

  if(page === 'home') {
    app.innerHTML = `
      <h2>🔥 Игровые разделы</h2>
      <div class="card"><h3>🎁 Кейсы</h3><p>Открывай кейсы и получай персонажей!</p><button onclick="go('cases')">Открыть кейсы</button></div>
      <div class="card"><h3>⚡ Апгрейд</h3><p>Пытайся улучшить своих персонажей.</p><button onclick="go('upgrade')">Перейти к апгрейду</button></div>
      <div class="card"><h3>🎒 Инвентарь</h3><p>Собирай свою коллекцию Brainrot.</p><button onclick="go('inventory')">Моя коллекция</button></div>
      <div class="card"><h3>🧠 Brainrot</h3><p>Исследуй мир мемных персонажей!</p><button onclick="go('brainrot')">Исследовать</button></div>
      <div class="card"><h3>🍀 Lucky Blocks</h3><p>Испытай удачу в бесплатном игровом режиме.</p><button onclick="go('lucky')">Открыть</button></div>
      <div class="card"><h3>🎮 Игры</h3><p>Игровые режимы BrainGet.</p><button onclick="go('games')">Выбрать игру</button></div>`;
  }

  if(page === 'cases') {
    app.innerHTML = `<h2>🎁 Кейсы</h2>
      <div class="card"><h3>📦 Базовый кейс</h3><p>Цена: 100 монет</p><p>Случайный персонаж из коллекции.</p><button onclick="openCase(100)">Открыть за 100 🪙</button></div>
      <div class="card"><h3>💎 Премиум-кейс</h3><p>Цена: 250 монет</p><p>Шанс получить редкого персонажа выше.</p><button onclick="openCase(250)">Открыть за 250 🪙</button></div>`;
  }

  if(page === 'inventory') {
    app.innerHTML = `<h2>🎒 Инвентарь</h2><p>Твои персонажи: ${data.inventory.length}</p>` +
      (data.inventory.length ? data.inventory.map((x,i) =>
      `<div class="item">${x.emoji} <strong>${x.name}</strong><p>${x.rarity} · Цена: ${x.value} 🪙</p><button class="secondary" onclick="sell(${i})">Продать за ${Math.floor(x.value/2)} 🪙</button></div>`
      ).join('') : '<div class="card"><p>Пока пусто! Открой первый кейс 🎁</p><button onclick="go(\'cases\')">К кейсам</button></div>');
  }

  if(page === 'upgrade') {
    app.innerHTML = `<h2>⚡ Апгрейд</h2>
      <div class="card"><p>Выбери персонажа. Улучшение стоит 50 монет. Шанс успеха — 50%.</p>` +
      (data.inventory.length ? `<select id="upgradeItem">` + data.inventory.map((x,i) =>
        `<option value="${i}">${x.emoji} ${x.name} (${x.rarity})</option>`
      ).join('') + `</select><button onclick="upgrade()">Попробовать улучшить</button>` :
      `<p>Сначала получи персонажа из кейса!</p><button onclick="go('cases')">К кейсам</button>`) + `</div>`;
  }

  if(page === 'brainrot') {
    app.innerHTML = `<h2>🧠 Brainrot</h2><div class="card"><p>Коллекционируй мемных персонажей и собирай свою команду!</p><button onclick="go('cases')">Получить персонажа</button></div>`;
  }

  if(page === 'lucky') {
    app.innerHTML = `<h2>🍀 Lucky Blocks</h2><div class="card"><p>Бесплатный игровой бонус раз в нажатие. Награда случайна!</p><button onclick="lucky()">Открыть блок 🎁</button></div>`;
  }

  if(page === 'games') {
    app.innerHTML = `<h2>🎮 Игры</h2><div class="card"><h3>🧠 Коллекционер</h3><p>Собери как можно больше персонажей.</p><button onclick="go('inventory')">Моя коллекция</button></div><div class="card"><h3>⚡ Испытание апгрейда</h3><p>Попробуй улучшить персонажа.</p><button onclick="go('upgrade')">Начать</button></div>`;
  }
}

function openCase(price) {
  if(data.coins < price) return say('❌ Недостаточно монет!');
  data.coins -= price;
  let pool = price === 250 ? rewards.slice(1) : rewards.slice(0,4);
  let reward = {...pool[Math.floor(Math.random()*pool.length)]};
  data.inventory.push(reward);
  save(); render();
  say('🎉 Получен персонаж: ' + reward.name + '!');
}

function sell(i) {
  const item = data.inventory.splice(i,1)[0];
  data.coins += Math.floor(item.value/2);
  save(); render();
  say('Продано! +' + Math.floor(item.value/2) + ' монет.');
}

function upgrade() {
  const select = document.getElementById('upgradeItem');
  if(!select) return;
  if(data.coins < 50) return say('❌ Нужно 50 монет!');
  data.coins -= 50;
  const i = Number(select.value);
  if(Math.random() < 0.5) {
    const item = data.inventory[i];
    const next = rewards.findIndex(x => x.rarity === item.rarity);
    if(next < rewards.length-1) {
      data.inventory[i] = {...rewards[next+1]};
      say('🔥 Успех! Новый персонаж: ' + data.inventory[i].name);
    } else {
      data.coins += 100;
      say('👑 Максимальный уровень! Бонус +100 монет.');
    }
  } else {
    say('😅 Не получилось! Попробуй ещё раз.');
  }
  save(); render();
}

function lucky() {
  const amount = Math.floor(Math.random()*101)+25;
  data.coins += amount;
  save();
  say('🍀 Ты получил ' + amount + ' монет!');
}

render();
</script>
</body>
</html>
